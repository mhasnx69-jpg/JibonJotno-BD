# Supabase Public Configuration (Safe for Browser & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Privileged Admin Key (Strictly Server-Only! Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature Flag: Keep live financial payments disabled until legal & merchant sign-off
ENABLE_LIVE_PAYMENTS=false
